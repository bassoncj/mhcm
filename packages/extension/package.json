{
  "name": "@mhcm/extension",
  "description": "Chrome/Firefox browser extension with Preact side panel UI",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/bassoncj/mhcm.git",
    "directory": "packages/extension"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "BUILD_TARGET=chrome vite build",
    "build:firefox": "BUILD_TARGET=firefox vite build",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "dev": "BUILD_TARGET=chrome vite build --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mhcm/shared": "*",
    "preact": "^10.25.0",
    "@preact/signals": "^1.3.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
